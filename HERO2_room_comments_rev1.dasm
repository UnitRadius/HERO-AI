LampGraphic			=	$DB64	; top-band lamp; destroying it changes cave light state
Reflected50PointGraphic		=	$DB6D	; bitmap is "05"; REFP0 mirrors it to display "50"
CreatureScorePopupGraphic	=	$DB76	; score-popup bitmap; code awards $50 BCD
SnakeGraphic0			=	$DB7F
HiddenP0Graphic			=	$DB8A
SnakeGraphic1			=	$DB92

; $DDxx: P0 color streams.  These are scanline pointers, so some begin
