;------------------------------------------------------
; H.E.R.O.
;	Atari 2600
; by John Van Ryzin
;
;  changes to original binary:
;
;	- fixed code to display 262 lines (not 263)
;	- darkend GUI panel grey color
;	- improved GUI lives/dynamite color tables
;	- made cave top/botom playfield brighter
;	- improved hero color table
;	- change copyright Activision date in logo to 2027
;	- fixed spider position level 2 screen 2
;
;-----------------------------------------------------

	processor	6502

;-----------------------------------------------------------
;   Color constants
;-----------------------------------------------------------

BLACK		=	$00
YELLOW		=	$10
BROWN		=	$20
ORANGE		=	$30
RED		=	$40
MAUVE		=	$50
VIOLET		=	$60
PURPLE		=	$70
BLUE		=	$80
BLUE_CYAN	=	$90
CYAN		=	$a0
CYAN_GREEN	=	$b0
GREEN		=	$c0
GREEN_YELLOW	=	$d0
GREEN_BEIGE	=	$e0
BEIGE		=	$f0

WHITE		=	$0e
DK_GREY		=	$02
DK_RED		=	$44
DK_GREEN	=	$c4
LT_GREY		=	$0c
LT_YELLOW	=	$1c
DK_BLUE		=	$82

;-----------------------------------------------------------
