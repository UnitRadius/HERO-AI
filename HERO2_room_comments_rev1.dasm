;         $ff (is)


;-----------------------------------------------------------
;  gameplay constants and contextual aliases
;-----------------------------------------------------------

SELECT_MASK		=	$7f
EXPERT_CYCLE_FLAG	=	$80
SELECT_RANDOM_LEVELS	=	$04
SELECT_REPEAT_DELAY	=	$1e

JOY_RIGHT		=	$70
JOY_LEFT		=	$b0
JOY_DOWN		=	$d0
JOY_NONE		=	$f0

HERO_FLYING		=	$00
HERO_STANDING		=	$40
HERO_RUNNING		=	$80

HORIZONTAL_TURN_DELAY		=	$03
NEUTRAL_VERTICAL_MOMENTUM	=	$1f

OBJECT_REMOVED_Y	=	$32
DAMAGE_LIFE_LOST	=	$96
HERO_RESPAWN_START_Y	=	$8c

POWER_FULL		=	$51
POWER_DRAIN_MASK	=	$3f
POWER_REFILL_GATE	=	$77

LASER_DISABLED		=	$fd
LASER_PHASE_STEP	=	$03
LASER_PHASE_MASK	=	$0f
LASER_HIT_PLAYFIELD	=	$80
LASER_HIT_BALL		=	$40
LASER_X_LIMIT		=	$9f

CREATURE_50_DISPLAY_TIME	=	$13
DYNAMITE_END_LEVEL_BONUS	=	$50
WALL_BURN_HALF			=	$80
ROOM_GLOWING_WALL		=	$02
MOVING_WALL_DAMAGE_MODE		=	$80

RAFT_LEFT_START		=	$80
RAFT_RIGHT_START	=	$60
RAFT_X_OFFSET		=	$1c
RAFT_TRAVEL		=	$60
RAFT_RIDE_Y		=	$17

MAX_LIVES		=	$07
SCORE_OVERFLOW_BCD	=	$bb

; Contextual RAM aliases. These addresses intentionally serve multiple jobs.
DisplayBandIndex		=	$e6
HeroVerticalBlockFlags		=	$e6
HeroPositionHandled		=	$bd
ConsoleSwitches			=	$fb
BottomLiquidFrame		=	$fb
Creature50DisplayTimer0		=	$f7
Creature50DisplayTimer1		=	$f8
UnusedCreature50TimerSlot	=	$f9
PreviousBottomObjectY		=	$ee
PreviousMiddleObjectY		=	$ef
PreviousTopObjectY		=	$f0
PreviousCaveColorLightState	=	$f1

ObjectY				=	$a1	; indexed 0..2: bottom, middle, top
ObjectX				=	$a5	; indexed 0..2: bottom, middle, top
DynamiteTimers			=	$de	; indexed 0..2
HeroMiddleBandBoundaryCollision	=	$e4
HeroTopBandBoundaryCollision	=	$e5


;-----------------------------------------------------------
;   User Defined Labels
;-----------------------------------------------------------

Break	=	$d000
Start	=	$f000


;***********************************************************
;   Bank 0 / 0..1
;***********************************************************

	SEG	CODE
	ORG	$0000
	RORG	$d000

;-----------------------------------------------------------
; powerup
;-----------------------------------------------------------
Break
	sei
	bit	Bank0Hotspot	;bankswitch
	ldx	#$ff
	txs
	jsr	Break
	brk
	brk

;-----------------------------------------------------------
; position objects subroutine
;-----------------------------------------------------------

Hposition
	cmp	#$00
	bne	HPositionNonZero
	lda	#$01
HPositionNonZero
	sec
	sta	WSYNC
	bcs	HPositionCoarseLoop
HPositionCoarseLoop
	sbc	#$0f
	bcs	HPositionCoarseLoop
	eor	#$0f
	asl
	asl
	asl
	asl
	adc	#$80
	sta	RESP0,x
	sta	WSYNC
	sta	HMP0,x
SixCycles
	rts

;-----------------------------------------------------------
; tables
;-----------------------------------------------------------

LevelNumberText
	.byte	$a1
	.byte	$a2,$a3,$a4,$a5,$a6,$a7,$a8,$a9
	.byte	$10,$11,$12,$13,$14,$15,$16,$17
	.byte	$18,$19

PowerBonusLowBCD
	.byte	$20,$40,$60,$80,$90,$00,$20,$60
	.byte	$00,$40,$80,$20,$60,$00,$20,$40
	.byte	$00,$40,$00,$99

PowerBonusHighBCD
	.byte	$00,$00,$00,$00,$00,$01,$01,$01
	.byte	$02,$02,$02,$03,$03,$04,$04,$04
	.byte	$05,$05,$06,$09

Bank0LevelLastRoomIndex
	.byte	$01
	.byte	$03,$05,$07,$07,$09,$0b,$0d,$0f
	.byte	$0f,$0f,$0f,$0f,$0f,$0f,$0f,$0f
	.byte	$0f,$0f,$0f


;***************************************
; display kernel
;***************************************
DisplayKernel
	lda	AttractAndIdlePrescaler
	bmi	BuildPanelGlyphPointers
	lda	GameInactiveFlag
	bne	CheckGameOverDisplay
	lda	PowerDrainEnabled
	bne	BuildPanelGlyphPointers
	beq	PrepareLevelNumberDisplay
CheckGameOverDisplay
	lda	Lives
	bne	BuildPanelGlyphPointers
	lda	ScoreHighBCD
	cmp	#$AA
	beq	BuildPanelGlyphPointers
	lda	FrontEndCountdown
	and	#$1F
	cmp	#$14
	bcc	BuildPanelGlyphPointers
PrepareLevelNumberDisplay
	lda	StartLevelSelection
	and	#$7f
	cmp	#$04
	beq	BuildPanelGlyphPointers
	lda	#$cd
	sta	Temp0
	lda	#$ef
	sta	Temp1
	ldx	LevelIndex
	lda	LevelNumberText,x
	sta	Temp2
BuildPanelGlyphPointers
	ldx	#$02
BuildPanelGlyphPointerLoop
	txa
	asl
	asl
	tay
	lda	Temp0,x
	and	#$f0
	lsr
	sta.wy	ram_85,y
	lda	Temp0,x
	and	#$0f
	asl
	asl
	asl
	sta.wy	ram_87,y
	dex
	bpl	BuildPanelGlyphPointerLoop
	lda	Temp0
	cmp	#$cd
	bne	FillUnusedPanelGlyphs
	bit	StartLevelSelection
	bpl	FillUnusedPanelGlyphs
	lda	#$D8
	sta	ram_8D
	lda	#$E0
	sta	ram_8F
FillUnusedPanelGlyphs
	inx
	ldy	#$50
FillBlankPanelGlyphLoop
	lda	ram_85,x
	bne	SetPanelGlyphPointerHighBytes
	sty	ram_85,x
	inx
	inx
	cpx	#$0a
	bcc	FillBlankPanelGlyphLoop
SetPanelGlyphPointerHighBytes
	ldx	#$0b
	lda	#$df
SetPanelGlyphHighLoop
	sta	ram_85,x
	dex
	dex
	bpl	SetPanelGlyphHighLoop
	bmi	WaitForVisibleDisplayTimer
ClearHeroGraphicForLine
	jmp	StoreHeroGraphicAndLoadBand
WaitForVisibleDisplayTimer
	lda	INTIM
	bne	WaitForVisibleDisplayTimer

;----------------------------------
; first line of display kernel
;----------------------------------

	sta	WSYNC			;start first line of display
	sta	HMOVE
	bit	IdleScreenBlankTimer
	bpl	BeginVisibleDisplay	;display game
	lda	#$02			;blank screen to avoid crt burn

BeginVisibleDisplay
	sta	VBLANK
	ldx	#$02
	stx	DisplayBandIndex
	dex				;x=1
	lda	HeroX			;position H.E.R.O. (TIA Player 1)
	sta	HMCLR
	jsr	Hposition
	ldx	#$04			;position ball
	lda	BallWallState
	jsr	Hposition

;--- draw cave decor top playfield

	sta	WSYNC
	sta	HMOVE
	lda	DynamiteExplosionFlash	;set background color
	sta	COLUBK
	lda	#$ff			;save pf0 graphic
	sta	Temp2
	dex	;set x to 3
DrawTopCaveTrimLoop
	lda	CaveColorBandShade,x		;get playfield color
	ora	CaveColorAndLightState
	sta	HMCLR			;finish positioning
	sta	WSYNC
	sta	HMOVE
	sta	COLUPF			;set playfield color
	lda	TopTrimPF0Masks,x	;set PF0-PF2
	sta	PF0
	lda	TopTrimPF12Masks,x
	and	TopPF1
	sta	PF1
	lda	TopTrimPF12Masks,x
	and	TopPF2
	sta	PF2			;do for 4 lines total
	dex
	bpl	DrawTopCaveTrimLoop

; The 116-line cave body is split into three logical bands.
; DisplayBandIndex starts at 2 and counts down: 2=top, 1=middle, 0=bottom.
; GRP1 is H.E.R.O.; GRP0 is time-multiplexed to draw up to two room objects per band.
; M1 is the laser.  The low bit embedded in the H.E.R.O. color stream also gates ENAM1.

;--- draw 3 display bands

	stx	ENABL		;turn on ball
	inx
	stx	NUSIZ0		;set player 1 to 8 bit width
	lda	#$61
	sta	VDELP0		;delay graphic writes to player 0
	lda	PlayerDirection	;set H.E.R.O. (P1) reflection
	sta	REFP1
	ldy	#116				;set line count to 116
	lda	(Ptr_HeroColorLow),y		;get H.E.R.O. color
	ldx	TopWallColor			;get playfield color
	nop
	sta	CXCLR		;clear collision registers
	nop
	stx	COLUPF		;set playfield color
	sta	HMOVE
	jmp	DrawDisplayBandLine

;--- next display band loop

HeroGraphicBlankPath	;loop
	sta.w	GRP1
	beq	StoreBoundaryCollisionAndPF2
DrawDisplayBandLine
	sta	COLUP1		;set H.E.R.O. color
	and	#$01		;if unused low color bit clear player 1 graphic
	beq	ClearHeroGraphicForLine
	lda	(Ptr_HeroGraphicLow),y	;get H.E.R.O. graphic

; Load all per-band state before the cycle-critical P0 object drawing sequence.
; BottomObjectY/PF/color arrays are intentionally indexed from their bottom element
; with DisplayBandIndex so +2 selects top, +1 middle, +0 bottom.

StoreHeroGraphicAndLoadBand
	sta	GRP1			;set H.E.R.O. graphic
	ldx	DisplayBandIndex	;get y of player 0
	lda	BottomObjectY,x
	sta	Temp1
	lda	CXM1FB			;save player 1 to playfield collision
	ora	LaserCollisionLatch
	sta	LaserCollisionLatch
	lda	P0ColorPtrLow0,x	;get pointers to player 0
	sta	P0ColorPtrLow
	lda	P0GraphicPtrLow0,x
	sta	P0GraphicPtrLow
	dey	;next line
	lda	BottomPF1,x		;get playfield 0
	tax
	lda	(Ptr_HeroColorLow),y	;set playfield 1
	stx	PF1
	ldx	Temp2
	sta	COLUP1			;set H.E.R.O. color
	sta	HMOVE
	stx	PF0			;set playfield 0
	ldx	CXP1FB			;read H.E.R.O./ball-playfield collision
	stx	CXCLR			;clear collisions
	and	#$01			;if unused low color bit clear player 1 graphic
	beq	HeroGraphicBlankPath
	lda	(Ptr_HeroGraphicLow),y	;get/set H.E.R.O. graphic
	sta	GRP1
StoreBoundaryCollisionAndPF2
	stx	Temp0			;save H.E.R.O./ball-playfield collision bits
	ldx	DisplayBandIndex	;get/set PF2
	lda	BottomPF2,x
	sta	PF2
	lda	BottomCTRLPF,x		;set playfield reflection and ball size
	sta	CTRLPF
	lda	Temp0			;save collision
	sta	HeroBottomBandBoundaryCollision,x
	dey	;next line
	lda	BottomWallColor,x	;get playfield color
	tax
	lda	(Ptr_HeroColorLow),y	;get/set H.E.R.O. color
	lda	(Ptr_HeroColorLow),y
	nop
	sta	COLUP1
	sta	HMOVE
	stx	COLUPF			;set playfield color
	sta	ENAM1			;low bit of H.E.R.O. color stream gates M1 laser
	and	#$01
	bne	LoadHeroGraphicAfterMissile
	sta	ENAM1	;otherwise disable M1 laser
	beq	StoreHeroGraphicBeforeP0Position	;and clear player 1 graphic
LoadHeroGraphicAfterMissile
	lda	(Ptr_HeroGraphicLow),y	;get H.E.R.O. graphic
StoreHeroGraphicBeforeP0Position
	sta	GRP1			;set H.E.R.O. graphic
	dey	;next line
	ldx	DisplayBandIndex	;get player 0 position
	lda	ram_D1,x
	sta	Temp0			;save it
	and	#$0f			;extract P0 coarse-position delay
	tax
	lda	(Ptr_HeroColorLow),y	;get H.E.R.O. color
	jsr	SixCycles		;waste cycles
	jsr	SixCycles
	dec	DisplayBandIndex	;next band
	sta.w	COLUP1			;set color player 1
	sta	HMOVE
	sta	ENAM1			;enable M1 laser
	and	#$01
	bne	LoadHeroGraphicBeforeP0CoarsePos
	sta	ENAM1			;disable M1 laser
	beq	StoreHeroGraphicBeforeP0CoarsePos
LoadHeroGraphicBeforeP0CoarsePos
	lda	(Ptr_HeroGraphicLow),y	;get/set H.E.R.O. graphics
StoreHeroGraphicBeforeP0CoarsePos
	sta.w	GRP1
	lda	Temp0			;get packed P0 fine-motion value
PositionFirstP0CoarseLoop
	dex				;coarse-position P0 object
	bne	PositionFirstP0CoarseLoop
	sta	RESP0
	sta	HMP0			;set fine position player 0
	dey				;next line
	sta	WSYNC
	sta	HMOVE
	lda	(Ptr_HeroColorLow),y	;get/set H.E.R.O. color
	sta	COLUP1
	sta	ENAM1			;enable M1 laser 1
	lsr
	bcc	BlankHeroAndMissileForP0	;M1 laser disabled
	lda	(Ptr_HeroGraphicLow),y	;get/set H.E.R.O. graphics
	sta	GRP1
	nop	;waste cycles

; First P0 object: derive vertical row from band-relative Y, then fetch graphic/color.
; ram_D1..D3 hold packed horizontal-position values here (coarse delay + fine motion).

BeginFirstP0Object
	ldx	#$12	;first P0 object scanline count
	sta	HMCLR	;finish reposition
DrawFirstP0ObjectLoop
	dey		;get next line and save it
	sty	Temp0
	txa		;player 0 vertical position at top of play band?
	sec
	sbc	Temp1
	tay
	cmp	#$0d
	bcc	LoadFirstP0Graphic	;yes
	ldy	#$00
	nop
	nop
	jmp	DrawFirstP0ColorAndHero

BlankHeroAndMissileForP0
	stx	ENAM1			;disable M1 laser
	stx	GRP1			;clear H.E.R.O. graphic
	bcc	BeginFirstP0Object
LoadFirstP0Graphic
	lda	(P0GraphicPtrLow),y	;get/set P0 object graphic
	sta	GRP0
DrawFirstP0ColorAndHero
	lda	(P0ColorPtrLow),y	;get P0 object color
	ldy	Temp0			;restore line count
	sta	COLUP0			;set player 0 color
	lda	(Ptr_HeroColorLow),y	;get H.E.R.O. color
	sta	HMOVE
	sta	COLUP1
	lsr					;missile enabled?
	bcs	EnableHeroMissileAndGraphic	;yes
	lda	#$00				;no, disable missile
	sta	ENAM1
	sta	GRP1
	beq	StoreHeroGraphicAfterMissile
EnableHeroMissileAndGraphic
	asl	;enable missile
	sta	ENAM1
	lda	(Ptr_HeroGraphicLow),y	;get/set H.E.R.O. graphics
StoreHeroGraphicAfterMissile
	sta.w	GRP1
	sta	GRP1
	dex				;next P0 object scanline
	bpl	DrawFirstP0ObjectLoop

	dey	;next line
	lda	CXPPMM			;save P0/P1 and M0/M1 collision bits
	ldx	DisplayBandIndex
	sta	ram_D2,x
	lda	P0SecondGraphicLow1,x	;lower player 0 band object (dynamite or miner)
	sta	P0SecondGraphicPtrLow
	lda	P0SecondColorLow1,x
	sta	P0ColorPtrLow
	lda	ram_D5,x
	and	#$0f
	tax
	lda	(Ptr_HeroColorLow),y		;get/set H.E.R.O. color
	sta	COLUP1
	lsr					;enable M1 laser?
	sta	HMOVE
	bcs	EnableHeroMissileSecondObject	;yes
	lda	#$00				;no
	sta	ENAM1
	sta	GRP1
	beq	StoreHeroGraphicBeforeSecondP0
EnableHeroMissileSecondObject
	asl					;enable M1 laser
	sta	ENAM1
	lda	(Ptr_HeroGraphicLow),y	;get/set H.E.R.O. graphic
StoreHeroGraphicBeforeSecondP0
	sta	GRP1
	dey					;next line

; Reposition P0 mid-band so the same TIA player can draw the band's second object.
; ram_D5..D7 are consumed as packed position values, then reused for collision results.

PositionSecondP0CoarseLoop
	dex					;coarse-position P0 object
	bne	PositionSecondP0CoarseLoop
	sta	RESP0
	lda	(Ptr_HeroColorLow),y		;get/set H.E.R.O. color
	sta	WSYNC
	sta	HMOVE
	sta	COLUP1
	sta	ENAM1				;enable M1 laser
	and	#$01
	bne	LoadHeroGraphicAfterSecondPosition
	sta	ENAM1				;disable M1 laser
	beq	StoreHeroGraphicAfterSecondPosition
LoadHeroGraphicAfterSecondPosition
	lda	(Ptr_HeroGraphicLow),y	;get/set H.E.R.O. graphic
StoreHeroGraphicAfterSecondPosition
	sta	GRP1
	ldx	DisplayBandIndex		;load second P0 packed horizontal-position value
	lda	ram_D5,x
	sta	HMP0
	lda	CXM1P				;save M1/P0 collision for this band
	sta	ram_D5,x
	ldx	#$0c
	dey					;next line and save it
	sty	Temp0
	ldy	#$0c				;second P0 object scanline count
	jsr	SixCycles			;waste cycles
DrawSecondP0ObjectLoop
	lda	(P0ColorPtrLow),y		;get P0 object color
	ldy	Temp0				;restore line count
	sta	COLUP0				;set color player 0
	lda	(Ptr_HeroColorLow),y		;get H.E.R.O. color
	sta	HMOVE
	sta	COLUP1				;set color player 1
	sta	ENAM1				;enable M1 laser
	and	#$01
	bne	LoadHeroGraphicInSecondP0Loop
	sta	ENAM1				;disable M1 laser
	beq	StoreHeroGraphicInSecondP0Loop
LoadHeroGraphicInSecondP0Loop
	lda	(Ptr_HeroGraphicLow),y		;get/set H.E.R.O. graphics
StoreHeroGraphicInSecondP0Loop
	sta	GRP1
	nop					;waste cycles
	dey					;next line
	bmi	DisplayBandsComplete		;last line so exit display bands

	sty	Temp0				;save line
	txa
	tay
	dex
	bmi	AdvanceToNextDisplayBand	;this display band is over

	sta	HMCLR				;finish player 0 reposition
	lda	(P0SecondGraphicPtrLow),y	;get/set P0 object graphics
	sta	GRP0
	lda	(P0ColorPtrLow),y
	nop
	jmp	DrawSecondP0ObjectLoop		;next line of player 0

; P0 objects for this band are complete.  Restore the cave playfield and enter
; the next band; MiddlePF0BoundaryMask contributes the one-sided Ball/PF0 boundary.

AdvanceToNextDisplayBand
	ldx	DisplayBandIndex	;next display band
	lda	MiddlePF0BoundaryMask
	ora	Ld9e2,x
	sta	Temp2
	lda	#$00			;clear player 0 graphic
	sta	GRP0
	ldy	Temp0			;restore line count
	ldx	CaveColorAndLightState	;get playfield color
	lda	(Ptr_HeroColorLow),y	;get color player1
	stx	ENAM1			;disable M1 laser
	stx.w	COLUPF				;set playfield color
	sta	HMOVE
	jmp	DrawDisplayBandLine	;do next band

DisplayBandsComplete

; Room body is finished.  The bottom decor/background changes to liquid coloring
; in the final room (and in later room-number ranges) before drawing the water/lava trim.

;--- display bands over

	ldx	LevelIndex		;enable water at cave bottom decor
	lda	Bank0LevelLastRoomIndex,x
	cmp	RoomIndex
	beq	UseBottomLiquidColor
	lda	DynamiteExplosionFlash
	ldx	RoomIndex
	cpx	#$0a
