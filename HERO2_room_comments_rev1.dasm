StartLevelSelection	=	$80
FrameCounter		=	$81
RandomLFSR		=	$82
SelectRepeatTimer	=	$83
ControllerDirections	=	$84
ram_85			=	$85
ram_86			=	$86
ram_87			=	$87
ram_88			=	$88
ram_89			=	$89
ram_8A			=	$8a
ram_8B			=	$8b
ram_8C			=	$8c
ram_8D			=	$8d
;         $8e (i)
ram_8F			=	$8f
;         $90 (i)
Ptr_HeroGraphicLow	=	$91
Ptr_HeroGraphicHigh	=	$92
P0GraphicPtrLow		=	$93
P0GraphicPtrHigh	=	$94
Ptr_HeroColorLow	=	$95
Ptr_HeroColorHigh	=	$96
P0ColorPtrLow		=	$97
P0ColorPtrHigh		=	$98
P0SecondGraphicPtrLow	=	$99
P0SecondGraphicPtrHigh	=	$9a
HeroX			=	$9b
RoomIndex		=	$9c
PreviousRoomIndex	=	$9d
FurthestRoomIndex	=	$9e
HeroY			=	$9f
BallWallState		=	$a0
BottomObjectY		=	$a1
MiddleObjectY		=	$a2
TopObjectY		=	$a3
CaveColorAndLightState	=	$a4
BottomObjectX		=	$a5
MiddleObjectX		=	$a6
TopObjectX		=	$a7
SecondP0X0		=	$a8
SecondP0X1		=	$a9
SecondP0X2		=	$aa
PowerLevel		=	$ab
HeroMovementState	=	$ac
HeroDamageState		=	$ad
HeroDamageBand		=	$ae
PowerDrainEnabled	=	$af
PlayerDirection		=	$b0
WallLaserBurnCounter	=	$b1
DynamiteCount		=	$b2
Lives			=	$b3
IdleScreenBlankTimer	=	$b4
AttractAndIdlePrescaler	=	$b5
FrontEndCountdown	=	$b6
ScoreHighBCD		=	$b7
ScoreMiddleBCD		=	$b8
ScoreLowBCD		=	$b9
GameInactiveFlag	=	$ba
Temp0			=	$bb
Temp1			=	$bc
Temp2			=	$bd
MiddlePF0BoundaryMask	=	$be
BottomPF1		=	$bf
MiddlePF1		=	$c0
TopPF1			=	$c1
BottomPF2		=	$c2
MiddlePF2		=	$c3
TopPF2			=	$c4
BottomWallColor		=	$c5
MiddleWallColor		=	$c6
TopWallColor		=	$c7
BottomCTRLPF		=	$c8
MiddleCTRLPF		=	$c9
TopCTRLPF		=	$ca
P0GraphicPtrLow0	=	$cb
;         $cc (i)
P0GraphicPtrLow2	=	$cd
P0ColorPtrLow0		=	$ce
;         $cf (i)
P0ColorPtrLow2		=	$d0
ram_D1			=	$d1
ram_D2			=	$d2
;         $d3 (i)
ram_D4			=	$d4
ram_D5			=	$d5
;         $d6 (i)
ram_D7			=	$d7
P0SecondGraphicLow0	=	$d8
P0SecondGraphicLow1	=	$d9
;         $da (i)
P0SecondColorLow0	=	$db
P0SecondColorLow1	=	$dc
;         $dd (i)
DynamiteTimer0		=	$de
DynamiteTimer1		=	$df
DynamiteTimer2		=	$e0
DynamiteExplosionFlash	=	$e1

HeroBottomDecorWallCollision	=	$e2
HeroBottomBandBoundaryCollision	=	$e3
;         $e4 (i)
;         $e5 (i)
ram_E6			=	$e6
HeroFlyAnimationPhase	=	$e7
HeroRunAnimationPhase	=	$e8
VerticalMomentum	=	$e9
ShortMotionOscillator	=	$ea
LongMotionOscillator	=	$eb
RaftMotion		=	$ec
PreviousBallWallState	=	$ed
;         $ee (i)
;         $ef (i)
;         $f0 (i)
;         $f1 (i)
LevelCompleteFlag	=	$f2
LaserHorizontalPhase	=	$f3
LaserCollisionLatch	=	$f4
LevelIndex		=	$f5
ObjectAnimationClock	=	$f6
Creature50DisplayTimer0	=	$f7
Creature50DisplayTimer1	=	$f8
;         $f9 (i)
DynamiteWallBonus	=	$fa
Temp3			=	$fb	;water animation in kernel / switch ib vblank
HorizontalTurnDelay	=	$fc
MovingWallPhase		=	$fd
