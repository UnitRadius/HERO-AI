;--- score and logo display subroutine

DisplayScore
	lda	#$07

DisplayLogo
	ldy	#$00
	sta	WSYNC
	sta	HMOVE
	sta	Temp1
	lda	#$07
	sta	VDELP0
	sta	VDELP1
	sty	GRP0
	sty	GRP1
	sty	GRP0
	sta	REFP0
	sta	REFP1
	lsr
	sta	NUSIZ0
	sta	RESP0
	sta	RESP1
	sta.w	RESBL
	sta	NUSIZ1
	lda	#$90
	sta	HMP1
	lda	#$80
	sta	HMP0
	nop
	nop

DrawSixGlyphRowLoop
	ldy	Temp1
	lda	(ram_8D),y
	tax
	lda	(ram_8F),y
	sta	HMOVE
	sta	Temp0
	lda	(ram_85),y
	sta	GRP0
	lda	(ram_87),y
	sta	GRP1
	lda	(ram_89),y
	sta	HMCLR
	sta	GRP0
	lda	(ram_8B),y
	ldy	Temp0
	sta	GRP1
	stx	GRP0
	sty	GRP1
	sty	GRP0
	dec	Temp1
	bpl	DrawSixGlyphRowLoop
	lda	#$80
	sta	HMP0
	sta	HMP1
	sta	WSYNC
	sta	HMOVE
	asl
	sta	GRP0
	sta	GRP1
	sta	GRP0
	rts

PlayerDamaged
	stx	HeroDamageBand
	lda	#$ff
	sta	HeroDamageState
	rts

