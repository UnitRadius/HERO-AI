HiddenSecondP0Graphic		=	$DA99
TentacleGraphic0		=	$DAA6
TentacleGraphic1		=	$DAB2
TentacleGraphic2		=	$DABE
TentacleGraphic3		=	$DACA
TentacleGraphic4		=	$DAD6
HeroDeadGraphic			=	$DAE2

; $DBxx: primary room/enemy P0 graphics
