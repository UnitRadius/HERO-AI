;--- tables

;------------------------------------------------------------
; Pointer-derived graphics/color aliases
;------------------------------------------------------------
; These addresses are not normally referenced as full 16-bit operands.
; Bank 1 constructs pointers by loading a fixed high byte ($DA/$DB/$DD)
; and selecting only the low byte from animation tables.  Several streams
; deliberately overlap unrelated tables or even executable code.

; $DAxx: second P0 graphics
DynamiteFuseGraphic0		=	$DA26
DynamiteFuseGraphic1		=	$DA33
DynamiteFuseGraphic2		=	$DA40
DynamiteExplosionGraphic0	=	$DA4D
DynamiteExplosionGraphic1	=	$DA58
DynamiteExplosionGraphic2	=	$DA65
