; Two entry points share the same BCD adder:
; ScoreOverflow starts at the middle score byte; AddScoreLowBCD starts at the low byte.
; Crossing the score bit-pattern threshold can award one extra life, capped at 7.

;--- score overflow subroutine

ScoreOverflow
	ldy	ScoreHighBCD
	sty	Temp0
	ldy	#$01
	bne	AddScoreBCD
AddScoreLowBCD
	ldy	ScoreHighBCD
	sty	Temp0
	ldy	#$02
AddScoreBCD
	sta	Temp1
	lda	FrontEndCountdown
	bne	ReturnFromScoreAdd
	lda	Temp1
	sed
	cmp	#$99

AddScoreBCDLoop
	adc.wy	ScoreHighBCD,y
	sta.wy	ScoreHighBCD,y
	lda	#$00
	dey
	bpl	AddScoreBCDLoop
	cld
	bcc	CheckExtraLifeThreshold
	sty	GameInactiveFlag
	sty	FrontEndCountdown
	lda	#$bb
	sta	ScoreHighBCD
	sta	ScoreMiddleBCD
	sta	ScoreLowBCD

CheckExtraLifeThreshold
	lda	Temp0
	and	#$12
	sta	Temp0
	lda	ScoreHighBCD
	and	#$12
	eor	Temp0
	beq	ReturnFromScoreAdd
	ldy	#$07
	cpy	Lives
	beq	ReturnFromScoreAdd
	inc	Lives

ReturnFromScoreAdd
	rts


