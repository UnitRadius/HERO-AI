INPT4	=	$0c	; (R)
VSYNC	=	$00	; (W)
VBLANK	=	$01	; (W)
WSYNC	=	$02	; (W)
NUSIZ0	=	$04	; (W)
NUSIZ1	=	$05	; (W)
COLUP0	=	$06	; (W)
COLUP1	=	$07	; (W)
COLUPF	=	$08	; (W)
COLUBK	=	$09	; (W)
CTRLPF	=	$0a	; (W)
REFP0	=	$0b	; (W)
REFP1	=	$0c	; (W)
PF0	=	$0d	; (W)
PF1	=	$0e	; (W)
PF2	=	$0f	; (W)
RESP0	=	$10	; (W)
RESP1	=	$11	; (W)
RESM1	=	$13	; (W)
RESBL	=	$14	; (W)
AUDC0	=	$15	; (W)
AUDC1	=	$16	; (W)
AUDF0	=	$17	; (W)
AUDF1	=	$18	; (W)
AUDV0	=	$19	; (W)
AUDV1	=	$1a	; (W)
GRP0	=	$1b	; (W)
GRP1	=	$1c	; (W)
ENAM1	=	$1e	; (W)
ENABL	=	$1f	; (W)
HMP0	=	$20	; (W)
HMP1	=	$21	; (W)
HMM1	=	$23	; (W)
HMBL	=	$24	; (W)
VDELP0	=	$25	; (W)
VDELP1	=	$26	; (W)
HMOVE	=	$2a	; (W)
HMCLR	=	$2b	; (W)
CXCLR	=	$2c	; (W)

SWCHA	=	$0280
SWCHB	=	$0282
INTIM	=	$0284
TIM64T	=	$0296

;-----------------------------------------------------------
