	sta	PF0
	lda	Ldc77,x		; icon-count mask for PF1
	sta	PF1
	dey
	bpl	Draw6Glyphs
	sta	WSYNC
	sta	HMOVE
	iny
	sty	PF0
	sty	PF1
	sty	PF2
	sty	GRP0
	sty	GRP1
	sty	GRP0
	rts

